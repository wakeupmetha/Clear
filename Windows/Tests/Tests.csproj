<Project Sdk="Microsoft.NET.Sdk">

  <!-- Обычная программа с проверками, без тестового фреймворка: так устроены и
       Tests/*Regression в апстриме. Как запускать — .github/README.md, раздел Build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Browser.Tests</AssemblyName>
    <RootNamespace>Browser.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

</Project>
