<?xml version="1.0" encoding="utf-8"?>
<!-- Источник пакетов только для этой папки: общий конфиг пользователя не трогаем.
     Ядру пакеты не нужны; они нужны приложению (Windows App SDK и WebView2). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
