<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ядро без UI и без WebView2: собирается и проверяется на любой ОС.
       Зависимостей нет и не должно появляться, как и в апстриме. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Browser.Core</AssemblyName>
    <RootNamespace>Browser</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Native AOT — наш рычаг скорости старта (вариант A из плана), поэтому JSON
         здесь через генерацию кода, без рефлексии. Флаг IsAotCompatible, который
         это проверяет, включить вместе с проектом приложения: ему нужен пакет
         анализаторов с nuget.org, а ядро должно собираться без сети. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Browser.Tests" />
  </ItemGroup>

</Project>
